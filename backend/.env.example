# Preppy backend — environment variable template
#
# Copy this file to .env and fill in your own development values.
# Never commit .env — only this template is committed.
# In production, set these variables in your hosting platform (Render, Railway, etc.).

# ---------------------------------------------------------------------------
# Database — required
# Prefer DATABASE_URL (single connection string). If absent, the app falls
# back to the individual DB_* variables below.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://preppy_user:yourpassword@localhost:5432/preppy_dev

# OR individual components (used only if DATABASE_URL is unset):
USER=preppy_user
PASSWORD=yourpassword
HOST=localhost
PORT=5432
DBNAME=preppy_dev

# ---------------------------------------------------------------------------
# Security — required
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# ---------------------------------------------------------------------------
SECRET_KEY=replace-with-a-random-hex-string
JWT_SECRET_KEY=replace-with-a-different-random-hex-string

# ---------------------------------------------------------------------------
# Google Gemini AI — required for all AI features
# Obtain from: https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
GOOGLE_API_KEY=your-google-api-key-here

# ---------------------------------------------------------------------------
# Environment — controls debug mode, cookie security, and log verbosity
# Values: "development" | "production"
# ---------------------------------------------------------------------------
FLASK_ENV=development

# ---------------------------------------------------------------------------
# CORS — comma-separated list of allowed frontend origins
# Development default: http://localhost:5173 (Vite dev server)
# Production: set to your deployed frontend domain, e.g. https://preppy.com
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173